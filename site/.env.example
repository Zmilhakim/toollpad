# Copy to .env.local and fill in. Every one of these is optional: the factory
# address is already in src/lib/contracts.ts, so the site runs against the live
# launchpad with none of this set.

# Overrides the factory in src/lib/contracts.ts — for pointing a preview build at
# a different deployment. Printed by `npm run deploy` in ../contracts.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Robinhood Chain RPC. Defaults to a public endpoint; use your own for anything
# with traffic.
NEXT_PUBLIC_RPC_URL=

# Block explorer used for the "↗" links.
NEXT_PUBLIC_EXPLORER_URL=
